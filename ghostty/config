# Theme — Catppuccin Mocha (bundled with Ghostty)
theme = Catppuccin Mocha
# Pure black background instead of Mocha's blue-grey base
background = #000000

# Font (Ghostty ships Nerd Font symbols built in, no patched font needed)
font-family = "JetBrains Mono"
font-size = 14
font-feature = calt
font-feature = liga
adjust-cell-height = 10%

# Window
background-opacity = 0.88
background-blur = 20
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
macos-titlebar-style = tabs
macos-option-as-alt = true
window-save-state = always

# Cursor
cursor-style = bar
cursor-style-blink = true
shell-integration-features = no-cursor,sudo,title

# Behaviour
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
unfocused-split-opacity = 0.85

# App icon
macos-icon = custom-style
macos-icon-ghost-color = #CDD6F4
macos-icon-screen-color = #1E1E2E,#313244

# Quick terminal (drop-down) on cmd+` (overrides macOS window cycling)
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# tmux prefix on macOS: Cmd+B sends Ctrl+B (tmux itself can't see Cmd)
keybind = cmd+b=text:\x02
