{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "output": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " OS ",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": " VER",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰥔 UP "
    },
    {
      "type": "packages",
      "key": "󰏗 PKG"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": " GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛 MEM",
      "format": "{used} / {total}"
    },
    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    }
  ]
}
