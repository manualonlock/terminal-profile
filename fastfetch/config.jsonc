{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "",
    "color": { "keys": "magenta" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "  {user-name-colored}{at-symbol-colored}{host-name-colored}" },
    "break",
    { "type": "os",     "key": "  󰀵  OS",  "keyColor": "red",    "format": "{name} {version}" },
    { "type": "uptime", "key": "  󰥔  UP",  "keyColor": "green" },
    { "type": "cpu",    "key": "    CPU", "keyColor": "yellow", "format": "{name}" },
    { "type": "memory", "key": "  󰍛  MEM", "keyColor": "blue" },
    "break"
  ]
}
