{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "{#31} OS ",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "{#32} VER",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "{#33}󰥔 UP "
    },
    {
      "type": "packages",
      "key": "{#34}󰏗 PKG"
    },
    {
      "type": "cpu",
      "key": "{#35} CPU",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "{#36} GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "{#37}󰍛 MEM",
      "format": "{used} / {total}"
    },
    {
      "type": "colors",
      "key": " ",
      "symbol": "circle"
    }
  ]
}
