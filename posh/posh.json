{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "base": "#1e1e2e",
    "crust": "#11111b",
    "text": "#cdd6f4",
    "overlay": "#6c7086",
    "rosewater": "#f5e0dc",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "blue": "#89b4fa",
    "lavender": "#b4befe"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:mauve",
          "foreground": "p:crust",
          "template": "{{ .Icon }} "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:red",
          "foreground": "p:crust",
          "template": "  "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:blue",
          "foreground": "p:crust",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": "  "
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:green",
          "foreground": "p:crust",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:peach{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "branch_icon": " "
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:yellow",
          "foreground": "p:crust",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true
          },
          "template": "  {{ if .Venv }}{{ .Venv }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:sky",
          "foreground": "p:crust",
          "options": {
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:green",
          "foreground": "p:crust",
          "options": {
            "display_mode": "files"
          },
          "template": "  {{ .Full }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": " {{ reason .Code }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:peach",
          "options": {
            "threshold": 2000,
            "style": "austin"
          },
          "template": " {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:overlay",
          "options": {
            "time_format": "15:04"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "foreground": "p:green",
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "foreground": "p:green",
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "p:mauve",
    "template": "❯❯ "
  }
}
